{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "src",
    "test"
  ]
}
